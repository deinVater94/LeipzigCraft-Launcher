<Application x:Class="LeipzigCraft.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#10110F"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#181A16"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#69B83D"/>
        <SolidColorBrush x:Key="GreenDarkBrush" Color="#2D6B24"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A7AB9F"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#D9A72D"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource GreenBrush}"/>
            <Setter Property="BorderBrush" Value="#85D756"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
