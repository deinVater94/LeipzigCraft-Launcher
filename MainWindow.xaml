<Window x:Class="LeipzigCraft.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LeipzigCraft Launcher"
        Width="1040"
        Height="650"
        MinWidth="900"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left branding panel -->
        <Border Grid.Column="0"
                Background="#0B0C0A"
                BorderBrush="#252820"
                BorderThickness="0,0,1,0">
            <Grid Margin="34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="0"
                       Source="/Assets/leipzigcraft-logo.png"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       MaxWidth="305"
                       MaxHeight="270"/>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="DEIN VIERTEL."
                               FontFamily="Impact"
                               FontSize="46"
                               Margin="0,0,0,-4"/>
                    <TextBlock Text="DEINE CREW."
                               FontFamily="Impact"
                               FontSize="46"
                               Foreground="{StaticResource GreenBrush}"
                               Margin="0,0,0,-4"/>
                    <TextBlock Text="DEIN REVIER."
                               FontFamily="Impact"
                               FontSize="46"/>

                    <TextBlock Margin="0,22,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="15"
                               TextWrapping="Wrap"
                               LineHeight="23">
                        Minecraft 1.21 · Fabric 0.18.4 · LeipzigCraft
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Foreground="#70756A"
                           FontSize="11"
                           Text="Launcher v0.1 · LeipzigCraft ist ein unabhängiges Community-Projekt."/>
            </Grid>
        </Border>

        <!-- Right control panel -->
        <Grid Grid.Column="1" Margin="46,38,46,38">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="LEIPZIGCRAFT STARTEN"
                           FontFamily="Impact"
                           FontSize="38"/>
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="14"
                           Text="Kein Modding nötig. Der Launcher kümmert sich um die Installation."/>
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,30,0,26"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="#2B2F27"
                    BorderThickness="1"
                    Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="MICROSOFT-KONTO"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GreenBrush}"/>
                            <TextBlock x:Name="AccountText"
                                       Margin="0,5,0,0"
                                       Text="Noch nicht angemeldet"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <Button x:Name="LoginButton"
                                Grid.Column="1"
                                Content="MIT MICROSOFT ANMELDEN"
                                Click="LoginButton_Click"
                                Margin="18,0,0,0"/>
                    </Grid>

                    <Border Grid.Row="1"
                            Height="1"
                            Background="#30342D"
                            Margin="0,24"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="INSTALLATION"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GreenBrush}"/>
                            <TextBlock x:Name="InstancePathText"
                                       Margin="0,5,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="28,0,0,0">
                            <TextBlock Text="RAM"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GreenBrush}"/>
                            <TextBlock Text="6 GB"
                                       Margin="0,5,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,34,0,0">
                        <TextBlock x:Name="StatusText"
                                   Text="Bereit."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Margin="0,0,0,10"/>

                        <ProgressBar x:Name="BusyProgress"
                                     Height="8"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed"
                                     Foreground="{StaticResource GreenBrush}"
                                     Background="#292D26"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Foreground="#787D72"
                           FontSize="12"
                           Text="Erster Start kann einige Minuten dauern."/>

                <Button x:Name="PlayButton"
                        Grid.Column="1"
                        Width="235"
                        Height="62"
                        FontSize="18"
                        Content="▶  SPIELEN"
                        Click="PlayButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
